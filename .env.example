# forgeSDLC environment variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Database (PostgreSQL — required) ──────────────────────────────────────────
# Run local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=changeme --name forgesdlc-db postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/forgesdlc

# ── Session security ──────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── LLM API keys ──────────────────────────────────────────────────────────────
# At minimum set GROQ_API_KEY (free tier) to use forgeSDLC without any cost.
# OPENAI_API_KEY required for Agents 2, 3, 5, 6, 7, 8, 10, 12, 13 (Pro/Enterprise).
# ANTHROPIC_API_KEY required for Agent 10 BYOK path (claude-sonnet-4-6).
# GOOGLE_API_KEY required for Agent 11 (gemini-1.5-pro, 1M context window).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Azure OpenAI (optional — overrides OpenAI if both are set) ────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ── ToolRouter configuration ──────────────────────────────────────────────────
# Cursor Background Agent (requires ToS review — see legal/cursor_api_review.md)
CURSOR_API_KEY=
CURSOR_API_VERIFIED=false

# Devin API (Enterprise tier)
DEVIN_API_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
RENDER_API_KEY=
RENDER_DEPLOY_HOOK_URL=
RENDER_TIER=free

# ── Observability (optional) ──────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=
TAVILY_API_KEY=

# ── Security scanning ─────────────────────────────────────────────────────────
# Set RUN_DAST=true only in local dev — NOT in CI (requires live app on port 18080)
RUN_DAST=false

# ── CI keyring backend (Linux GitHub Actions only) ────────────────────────────
# PYTHON_KEYRING_BACKEND=keyrings.alt.PlaintextKeyring

# ── Subscription tier (local dev override) ────────────────────────────────────
# Set to 'pro' or 'enterprise' to test paid-tier routing locally.
# In production, tier comes from a JWT via FORGESDLC_SESSION_TOKEN.
# Options: free (default) | pro | enterprise
FORGESDLC_TIER=free

# Set to 'true' when running in CI to make API key checks advisory (not hard-fail)
FORGESDLC_CI=false

# ── Local model servers (optional) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Advanced / optional ──────────────────────────────────────────────────────
MISTRAL_CODESTRAL_KEY=
# DAST target port — the app under test must be listening here
FORGESDLC_DAST_PORT=18080
